{
  "uid": "shop-limits",
  "title": "Shop limits and alerts",
  "tags": [
    "shop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 13,
      "title": "Alerts (pending or firing)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=~\"pending|firing\"}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Alert rules from deploy/observability/alerts; empty when nothing is wrong."
    },
    {
      "id": 14,
      "title": "Rate limit rejections (API, per rule)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (rule) (rate(shop_rate_limit_rejected_total{job=\"shop-api\"}[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "legendFormat": "{{rule}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Per-account 429s from the API limiter. Envoy's per-IP 429s never reach the API and are not counted here. Empty until the first rejection."
    },
    {
      "id": 15,
      "title": "Rate limiter backend failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(shop_rate_limit_backend_failures_total{job=\"shop-api\"}[5m]))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "legendFormat": "failures per s"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Requests let through because the limiter could not reach Valkey (fail open)."
    }
  ]
}
