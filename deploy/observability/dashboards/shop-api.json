{
  "uid": "shop-api",
  "title": "Shop API",
  "tags": [
    "shop"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "API replicas",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "count(last_over_time(target_info{job=\"shop-api\"}[30s]))",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Series of pods that stopped reporting drop out after 30 s (OTLP never marks them stale)."
    },
    {
      "id": 2,
      "title": "Request rate by route and status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 10,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"shop-api\"}[1m]))",
          "legendFormat": "{{uri}} {{status}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "5xx ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"shop-api\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"shop-api\"}[1m]))",
          "legendFormat": "5xx",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Dead-lettered events",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(shop_events_dead_letter_rows{job=\"shop-api\"})",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Event publications parked after giving up; they need a person (refunds included)."
    },
    {
      "id": 5,
      "title": "Latency p50, p95, p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"shop-api\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"shop-api\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"shop-api\"}[1m])))",
          "legendFormat": "p99",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Hikari connections per pod (max 15)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (instance) (hikaricp_connections_active{job=\"shop-api\"})",
          "legendFormat": "{{instance}} active",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "max by (instance) (hikaricp_connections_idle{job=\"shop-api\"})",
          "legendFormat": "{{instance}} idle",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "max by (instance) (hikaricp_connections_pending{job=\"shop-api\"})",
          "legendFormat": "{{instance}} pending",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "max by (instance) (hikaricp_connections_max{job=\"shop-api\"})",
          "legendFormat": "{{instance}} max",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Pool maximum is 15 per pod; a rising pending line is the connection bottleneck."
    },
    {
      "id": 7,
      "title": "Executor threads and queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (name) (executor_active_threads{job=\"shop-api\"})",
          "legendFormat": "{{name}} active",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "sum by (name) (executor_queued_tasks{job=\"shop-api\"})",
          "legendFormat": "{{name}} queued",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Expiry job: released units and runs",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(shop_reservations_released_units_total{job=\"shop-api\"}[5m]))",
          "legendFormat": "units released per s",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        },
        {
          "expr": "sum(rate(tasks_scheduled_execution_seconds_count{job=\"shop-api\"}[5m]))",
          "legendFormat": "scheduled task runs per s",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "JVM heap used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"shop-api\",area=\"heap\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Process CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (instance) (process_cpu_usage{job=\"shop-api\"})",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "{service_name=\"shop-api\"}",
          "queryType": "range",
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "id": 12,
      "title": "Recent traces",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "query": "{resource.service.name=\"shop-api\"}",
          "queryType": "traceql",
          "limit": 20,
          "tableType": "traces",
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Open a trace; the span view links to its log lines."
    }
  ]
}
